{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "EventService"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=eventplatform;Username=eventplatform;Password=eventplatform"
  },
  "Seed": {
    "Path": "/app/seed"
  },
  "Redis": {
    "Connection": "localhost:6379"
  },
  "Aws": {
    "AccessKey": "",
    "SecretKey": "",
    "Region": "us-east-1"
  },
  "Sns": {
    "TopicName": "event-created",
    "QueueName": "notification-service-event-created"
  },
  "Oidc": {
    "Authority": "http://localhost:8080/realms/master",
    "Audience": "master-realm"
  },
  "CloudWatch": {
    "Enabled": false,
    "LogGroup": "event-platform/EventService"
  }
}
