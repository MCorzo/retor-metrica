{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "NotificationService"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5433;Database=eventplatform;Username=eventplatform;Password=eventplatform"
  },
  "Seed": {
    "Path": "/app/seed"
  },
  "Aws": {
    "AccessKey": "",
    "SecretKey": "",
    "Region": "us-east-1"
  },
  "Sns": {
    "TopicName": "event-created",
    "QueueName": "notification-service-event-created",
    "DlqName": "notification-service-event-created-dlq"
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025
  },
  "Email": {
    "AdminAddress": "admin@event-platform.local",
    "MaxTransientAttempts": 5
  },
  "Oidc": {
    "Authority": "http://localhost:8080/realms/master",
    "Audience": "master-realm"
  },
  "CloudWatch": {
    "Enabled": false,
    "LogGroup": "event-platform/NotificationService"
  }
}
