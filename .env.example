# AWS credentials - copy this file to `.env` and fill in real values.
# Never commit real credentials. See contracts/aws-environment-variables.md.
#
# PostgreSQL - per-service dedicated databases. Each API connects to its own instance.
# Events DB (host port 5432)
POSTGRES_EVENTS_DB=eventplatform
POSTGRES_EVENTS_USER=eventplatform
# Notifications DB (host port 5433)
POSTGRES_NOTIFICATIONS_DB=eventplatform
POSTGRES_NOTIFICATIONS_USER=eventplatform
# Shared password used by both instances
POSTGRES_PASSWORD=eventplatform

# AWS (feature 002) - shared credentials/region, fill in real non-committed values
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
SNS_TOPIC_NAME=event-created
SNS_QUEUE_NAME=notification-service-event-created
# Optional: DLQ for failed email notifications (feature 004). 14-day retention is
# enforced at provisioning regardless of the name.
SNS_DLQ_NAME=notification-service-event-created-dlq
EMAIL_MAX_TRANSIENT_ATTEMPTS=5